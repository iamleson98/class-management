# ─────────────────────────────────────────────────────────────────
# Swarm stack configuration. Copy to .env and fill in.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# Your apex domain. Traefik routes subdomains: app.<DOMAIN>, api.<DOMAIN>,
# minio.<DOMAIN>, grafana.<DOMAIN>, traefik.<DOMAIN>.
DOMAIN=example.com

# Let's Encrypt account email (for TLS cert issuance).
ACME_EMAIL=you@example.com

# Traefik dashboard basic-auth. Generate with:
#   htpasswd -nb admin 'yourpassword' | sed 's/\$/\$\$/g'
# The $$ escaping is required because Traefik interprets $ in the label.
TRAEFIK_AUTH=admin:$$apr1$$xyz$$REPLACE_ME

# ── Private registry (in-cluster) ──
# Leave as the in-cluster host unless using an external registry.
REGISTRY=127.0.0.1:5000
REGISTRY_USERNAME=lms
# Set by secrets-bootstrap.sh from terraform output; only needed if you run
# build-and-push.sh from outside the manager.
REGISTRY_PASSWORD=

# Image tag to build/deploy.
TAG=latest

# ── PostgreSQL ──
POSTGRES_USER=mmuser
POSTGRES_DB=mattermost
PGHOST=postgres
# POSTGRES password + DSN are generated as Swarm secrets by
# secrets-bootstrap.sh (do NOT put them here).

# ── MinIO ──
MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD is a Swarm secret (secrets-bootstrap.sh).
MM_FILESETTINGS_AMAZONS3_BUCKET=lms-uploads

# ── Grafana ──
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD is a Swarm secret (secrets-bootstrap.sh).

TZ=UTC
