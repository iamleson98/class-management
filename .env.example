# ─────────────────────────────────────────────────────────────────
# LMS deployment configuration (single-host docker compose).
# Copy to `.env` and fill in secrets:
#   cp .env.example .env
#
# For the production Docker Swarm deployment on Contabo, use
# deploy/swarm/.env.example instead — see DEPLOY.md.
# ─────────────────────────────────────────────────────────────────

# Host ports to publish (change if a port is already in use on the host)
BACKEND_PORT=8065
FRONTEND_PORT=3000
RUSTFS_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
PROXY_PORT=80
TZ=UTC

# ── PostgreSQL (backend database) ──
POSTGRES_USER=mmuser
# CHANGE ME — required
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=mattermost

# Backend DSN, built from the values above. The host `postgres` is the
# service name on the compose network.
# Format: postgres://USER:PASSWORD@postgres:5432/DB?sslmode=disable&connect_timeout=10
MM_SQLSETTINGS_DATASOURCE=postgres://mmuser:change-me-to-a-strong-password@postgres:5432/mattermost?sslmode=disable&connect_timeout=10

# ── rustfs (S3-compatible file storage — same engine as prod) ──
RUSTFS_ACCESS_KEY=lms
# CHANGE ME — required
RUSTFS_SECRET_KEY=change-me-rustfs-secret
MM_FILESETTINGS_AMAZONS3BUCKET=lms-uploads

# ── Backend ──
# Public URL users reach the backend through (set to your real domain in prod)
MM_SERVICESETTINGS_SITEURL=http://localhost:8065
# CORS origins accepted with credentials (space-separated). Default covers
# the local dev frontend.
MM_SERVICESETTINGS_ALLOWCORSFROM=http://localhost:3001

# ── Frontend ──
# Where the frontend server (run-server.js) proxies /api/v4 — REST AND the
# chat/calls WebSocket. The default hits the compose backend service; for a
# separated deployment point it at any reachable backend origin.
LMS_BACKEND_URL=http://lms-server:8065

# ── Grafana ──
GRAFANA_ADMIN_USER=admin
# CHANGE ME — required
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
