# App
APP_URL="http://localhost:3000"

# Backend API URL (used by frontend for direct API calls / proxy target)
# Dev default: the local Go server. In production the Docker image bakes "/"
# (same-origin sentinel — the reverse proxy routes /api/v4/* to the backend),
# so this file is only used for local development.
NEXT_PUBLIC_API_URL=http://localhost:8065

# Optional SMTP (for forgot/reset password emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
