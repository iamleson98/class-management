generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

// ==================== CORE ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("STUDENT") // SUPER_ADMIN, ADMIN, COUNSELOR, TEACHER, ACCOUNTANT, MARKETING, PARENT, STUDENT
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String?

  branch           Branch?           @relation(fields: [branchId], references: [id])
  parentProfile    Parent?
  teacherProfile   Teacher?
  studentProfile   Student?
  teachingSessions Session[]         @relation("TeacherSessions")
  teachingClasses  Class[]           @relation("ClassTeacher")
  uploadedMaterials Material[]
  leadActivities   LeadActivity[]
  counselingLeads  Lead[]            @relation("CounselorLeads")
  payments         Payment[]
  approvedRefunds  FeeRefund[]
  posts            Post[]
  resetToken       String?
  resetTokenExpiry DateTime?

  auditLogs        AuditLog[]
  notifications    Notification[]
  createdTasks     Task[]            @relation("TaskCreator")
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdReviews   WeeklyReview[]    @relation("ReviewCreator")
  assignedHomework Homework[]        @relation("HomeworkTeacher")
  uploadedMedia    ClassMedia[]

  @@map("users")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  rooms     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  students Student[]
  classes  Class[]

  @@map("branches")
}

model Parent {
  id       String   @id @default(cuid())
  userId   String   @unique
  name     String
  phone    String
  email    String?
  address  String?
  relation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@map("parents")
}

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  code        String   @unique
  name        String
  dob         String?
  gender      String?
  school      String?
  schoolGrade String?
  status      String   @default("STUDYING") // STUDYING, SUSPENDED, QUIT, WAITING, COMPLETED
  parentName  String?
  vmgClassCode String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  branchId String?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Parent?        @relation(fields: [parentId], references: [id])
  branch         Branch?        @relation(fields: [branchId], references: [id])
  studentClasses StudentClass[]
  attendances    Attendance[]
  submissions    Submission[]
  tuitions       Tuition[]
  lead           Lead?
  weeklyReviews  WeeklyReview[]
  homeworkSubmissions HomeworkSubmission[]

  @@map("students")
}

model Teacher {
  id             String @id @default(cuid())
  userId         String @unique
  specializations String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teachers")
}

// ==================== ACADEMIC ====================

model Course {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  level              String?
  ageRange           String?
  totalSessions      Int      @default(24)
  durationPerSession Int      @default(90)
  fee                Float?
  description        String?
  curriculum         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  classes     Class[]
  lessons     CourseLesson[]
  materials   Material[]
  feePackages FeePackage[]
  submissions Submission[]
  homework    Homework[]

  @@map("courses")
}

model CourseLesson {
  id            String @id @default(cuid())
  courseId      String
  sessionNumber Int
  title         String
  unit          String?
  pages         String?
  objectives    String?

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([courseId, sessionNumber])
  @@map("course_lessons")
}

model Class {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  courseId  String
  teacherId String
  room      String?
  maxSize   Int      @default(15)
  status    String   @default("OPEN") // OPEN, ACTIVE, PAUSED, COMPLETED, CLOSED
  startDate String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String?

  course             Course          @relation(fields: [courseId], references: [id])
  teacher            User            @relation("ClassTeacher", fields: [teacherId], references: [id])
  branch             Branch?         @relation(fields: [branchId], references: [id])
  sessions           Session[]
  studentEnrollments StudentClass[]
  tuitions           Tuition[]
  weeklyReviews      WeeklyReview[]
  homework           Homework[]
  classMedia         ClassMedia[]

  @@map("classes")
}

model StudentClass {
  id         String   @id @default(cuid())
  studentId  String
  classId    String
  enrolledAt DateTime @default(now())
  status     String   @default("ACTIVE")

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@map("student_classes")
}

model Session {
  id        String   @id @default(cuid())
  title     String?
  date      String
  startTime String
  endTime   String
  room      String?
  classId   String
  teacherId String
  lessonId  String?
  status    String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class          @relation(fields: [classId], references: [id])
  teacher     User           @relation("TeacherSessions", fields: [teacherId], references: [id])
  lesson      CourseLesson?  @relation(fields: [lessonId], references: [id])
  attendances Attendance[]
  submissions Submission[]
  homework    Homework[]
  classMedia  ClassMedia[]

  @@map("sessions")
}

model Attendance {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  status    String   @default("PRESENT") // PRESENT, ABSENT_EXCUSED, ABSENT_UNEXCUSED, LATE, EARLY_LEAVE, MAKEUP
  note      String?
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("attendances")
}

model Material {
  id           String   @id @default(cuid())
  title        String
  description  String?
  fileUrl      String?
  fileName     String?
  fileType     String?
  courseId     String
  unit         String?
  visibility   String   @default("TEACHER_ONLY") // TEACHER_ONLY, ALL
  version      Int      @default(1)
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course @relation(fields: [courseId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])
  submissions Submission[]

  @@map("materials")
}

model Submission {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  fileName    String?
  fileType    String?
  grade       String?
  feedback    String?
  sessionId   String?
  studentId   String
  courseId    String
  materialId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session  Session?  @relation(fields: [sessionId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])
  course   Course   @relation(fields: [courseId], references: [id])
  material Material? @relation(fields: [materialId], references: [id])

  @@map("submissions")
}

// ==================== CRM ====================

model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  age         String?
  school      String?
  need        String?
  source      String? // Website, Facebook, Zalo, Referral, Walk-in
  status      String   @default("NEW") // NEW, CONTACTED, TEST_SCHEDULED, TESTED, FEE_PENDING, ENROLLED, NOT_INTERESTED
  counselorId String?
  notes       String?
  studentId   String?  @unique
  testDate    String?
  testResult  String?
  testScore   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  counselor User?        @relation("CounselorLeads", fields: [counselorId], references: [id])
  student   Student?     @relation(fields: [studentId], references: [id])
  activities LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(cuid())
  leadId       String
  type         String   // CALL, SMS, NOTE, VISIT, EMAIL
  content      String?
  nextFollowUp String?
  createdBy    String
  createdAt    DateTime @default(now())

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id])

  @@map("lead_activities")
}

// ==================== ACADEMIC EXTENSIONS ====================

model WeeklyReview {
  id         String   @id @default(cuid())
  studentId  String
  classId    String
  weekNumber Int
  content    String
  rating     Int?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  creator User    @relation("ReviewCreator", fields: [createdBy], references: [id])

  @@unique([studentId, classId, weekNumber])
  @@map("weekly_reviews")
}

model Homework {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  fileName    String?
  sessionId   String?
  classId     String
  courseId    String
  teacherId   String
  deadline    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session    Session?             @relation(fields: [sessionId], references: [id])
  class      Class                @relation(fields: [classId], references: [id])
  course     Course               @relation(fields: [courseId], references: [id])
  teacher    User                 @relation("HomeworkTeacher", fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]

  @@map("homework")
}

model HomeworkSubmission {
  id          String    @id @default(cuid())
  homeworkId  String
  studentId   String
  fileUrl     String?
  fileName    String?
  grade       String?
  feedback    String?
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

model ClassMedia {
  id           String   @id @default(cuid())
  classId      String
  sessionId    String?
  title        String?
  fileUrl      String
  fileType     String   // PHOTO, VIDEO
  uploadedById String
  createdAt    DateTime @default(now())

  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  session    Session? @relation(fields: [sessionId], references: [id])
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@map("class_media")
}

// ==================== FINANCE ====================

model FeePackage {
  id               String   @id @default(cuid())
  courseId         String
  name             String
  totalFee         Float
  sessionsIncluded Int
  discountPercent  Float    @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course   Course    @relation(fields: [courseId], references: [id])
  tuitions Tuition[]

  @@map("fee_packages")
}

model Tuition {
  id               String   @id @default(cuid())
  studentId        String
  classId          String
  feePackageId     String
  totalAmount      Float
  discountAmount   Float    @default(0)
  discountType     String?  // PERCENT, FIXED_VND
  discountValue    Float?   // percentage number or VND amount
  promotionalFee   Float?   // totalAmount + additionalFees - discount
  paidAmount       Float    @default(0)
  remainingAmount  Float
  status           String   @default("UNPAID") // PAID, PARTIAL, UNPAID, OVERDUE
  dueDate          String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student       Student        @relation(fields: [studentId], references: [id])
  class         Class          @relation(fields: [classId], references: [id])
  feePackage    FeePackage     @relation(fields: [feePackageId], references: [id])
  payments      Payment[]
  refunds       FeeRefund[]
  additionalFees AdditionalFee[]

  @@map("tuitions")
}

model AdditionalFee {
  id        String   @id @default(cuid())
  tuitionId String
  label     String   // BÁN_TRÚ, TRÔNG_MUỘN, ĐƯA_ĐÓN, NỘI_TRÚ, TÀI_LIỆU, ĐỒNG_PHỤC
  amount    Float
  createdAt DateTime @default(now())

  tuition Tuition @relation(fields: [tuitionId], references: [id], onDelete: Cascade)

  @@map("additional_fees")
}

model Payment {
  id            String   @id @default(cuid())
  tuitionId     String
  amount        Float
  method        String   @default("CASH") // CASH, TRANSFER, CARD
  receiptNumber String?
  paidById      String
  note          String?
  createdAt     DateTime @default(now())

  tuition Tuition @relation(fields: [tuitionId], references: [id])
  paidBy  User    @relation(fields: [paidById], references: [id])

  @@map("payments")
}

model FeeRefund {
  id           String   @id @default(cuid())
  tuitionId    String
  amount       Float
  reason       String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tuition    Tuition @relation(fields: [tuitionId], references: [id])
  approvedBy User?   @relation(fields: [approvedById], references: [id])

  @@map("fee_refunds")
}

// ==================== TASKS ====================

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  assigneeId  String
  creatorId   String
  deadline    String?
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String   @default("TODO") // TODO, IN_PROGRESS, PENDING_REVIEW, DONE, OVERDUE
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee User @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User @relation("TaskCreator", fields: [creatorId], references: [id])

  @@map("tasks")
}

// ==================== CMS ====================

model PostCategory {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts Post[]

  @@map("post_categories")
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  content        String?
  excerpt        String?
  categoryId     String
  imageUrl       String?
  authorId       String
  status         String    @default("DRAFT") // DRAFT, PENDING, PUBLISHED
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category PostCategory @relation(fields: [categoryId], references: [id])
  author   User         @relation(fields: [authorId], references: [id])

  @@map("posts")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String?
  linkUrl   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

// ==================== SYSTEM ====================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String?
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
